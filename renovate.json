{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":gitSignOff",
    ":disableDependencyDashboard"
  ],
  "enabledManagers": [
    "tekton",
    "dockerfile"
  ],
  "tekton": {
    "managerFilePatterns": ["/\\.yaml$/"],
    "includePaths": [".tekton/**"]
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "registry.access.redhat.com/ubi9/ubi-minimal"
      ],
      "versioning": "redhat"
    }
  ]
}
